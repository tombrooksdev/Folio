# Folio configuration (shell syntax: NAME=value). Restart after editing:
#   sudo systemctl restart folio
#
# Port to listen on
PORT=3000
#
# Set both of these to 1 when Folio sits behind an HTTPS reverse proxy (Caddy, nginx, Traefik)
#FOLIO_SECURE_COOKIES=1
#FOLIO_TRUST_PROXY=1
#
# Listen only on this machine (use with a reverse proxy on the same host)
#FOLIO_HOST=127.0.0.1
#
# Largest attachment in megabytes
#FOLIO_MAX_UPLOAD_MB=25
#
# GitHub token for private repositories or higher rate limits (read-only scope is enough)
#FOLIO_GITHUB_TOKEN=
