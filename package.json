{
  "name": "folio",
  "version": "0.7.0",
  "description": "Self-hosted wiki: spaces, nested pages, Markdown, search, version history.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "add-user": "node scripts/add-user.js",
    "backup": "node scripts/backup.js",
    "package": "bash packaging/build.sh"
  },
  "dependencies": {
    "express": "^4.21.0",
    "marked": "^14.1.0",
    "sanitize-html": "^2.13.0"
  },
  "license": "MIT",
  "author": "Tom Brooks <https://tombrooks.dev>",
  "keywords": [
    "wiki",
    "confluence-alternative",
    "jira-alternative",
    "scrum",
    "kanban",
    "self-hosted",
    "markdown",
    "sqlite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tombrooksdev/Folio.git"
  },
  "homepage": "https://github.com/tombrooksdev/Folio#readme",
  "bugs": {
    "url": "https://github.com/tombrooksdev/Folio/issues"
  }
}
